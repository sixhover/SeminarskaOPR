using AxWMPLib;
using MediaPlayer.Core;
using System;
using System.Windows.Forms;
using WMPLib;
using static MediaPlayer.Core.MediaItem;

namespace SeminarskaOPR
{
    public partial class Form1 : Form, IVolumeControl
    {
        private Playlist playlist;
        private PlayerStats stats;
        private MediaItem[] trenutnoPrikazani;

        private bool isMuted = false;
        private int lastVolume = 50;

        public delegate void NotificationDelegate(string sporocilo);

        public int CurrentVolume
        {
            get {return axWindowsMediaPlayer.settings.volume;}
            set { axWindowsMediaPlayer.settings.volume = value; }
        }
        public void Mute()
        {
            if (!isMuted)
            {
                lastVolume = CurrentVolume;
                CurrentVolume = 0;

                isMuted = true;
            }
            else
            {
                CurrentVolume = lastVolume;
                isMuted = false;
            }
        }

        public async void FadeOut(int steps, int intervalMs)
        {
            if (steps <= 0) return;
            int decrement = CurrentVolume / steps;
            for (int i = 0; i < steps; i++)
            {
                int newVal = CurrentVolume - decrement;
                CurrentVolume = (newVal < 0) ? 0 : newVal;
                await System.Threading.Tasks.Task.Delay(intervalMs);
            }
            axWindowsMediaPlayer.Ctlcontrols.stop();
        }

        public Form1()
        {
            InitializeComponent();

            playlist = new Playlist();
            stats = new PlayerStats();

            // NAROČANJE NA DOGODKE - To omogoči, da Form1 "posluša" spremembe
            
            // Naročimo se na event ItemPlayed - ko se pesem predvaja
            // Handler: stats_ItemPlayed() - posodobi prikaz na zaslonu
            stats.ItemPlayed += stats_ItemPlayed;

            // Naročimo se na event PlaylistChanged - ko se playlista spremeni
            // Handler: playlist_PlaylistChanged() - prikaže kaj je bilo spremenjeno
            playlist.PlaylistChanged += playlist_PlaylistChanged;

            // Naročimo se na event PlaylistError - ko je napaka pri dodajanju pesmi
            // Handler: playlist_PlaylistError() - prikaže obvestilo o napaki
            playlist.PlaylistError += playlist_PlaylistError;

            if (trkVolume != null)
            {
                trkVolume.Minimum = 0;
                trkVolume.Maximum = 100;
                trkVolume.Value = 50;

                if (axWindowsMediaPlayer != null && axWindowsMediaPlayer.settings != null)
                {
                    axWindowsMediaPlayer.settings.volume = trkVolume.Value;
                    axWindowsMediaPlayer.uiMode = "none";
                }
            }

            if (axWindowsMediaPlayer != null)
            {
                try
                {
                    // Naročimo se na Windows Media Player dogodke
                    
                    // PlayStateChange - ko se spremenitra stanje predvajanja (play, pause, stop, ended)
                    // Handler: axMediaPlayer_PlayStateChange() - avtomatsko gre na naslednjo pesem
                    axWindowsMediaPlayer.PlayStateChange += axMediaPlayer_PlayStateChange;
                    
                    // OpenStateChange - ko se datoteka odpre v predvajalniku
                    // Handler: axMediaPlayer_OpenStateChange() - prikaže, da je datoteka odprta
                    axWindowsMediaPlayer.OpenStateChange += axMediaPlayer_OpenStateChange;
                    
                    axWindowsMediaPlayer.uiMode = "none";
                    if (axWindowsMediaPlayer.settings != null && trkVolume != null)
                    {
                        axWindowsMediaPlayer.settings.volume = trkVolume.Value;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Napaka pri inicializaciji predvajalnika: " + ex.Message);
                }
            }

            if (buttonFullScreen != null)
            {
                buttonFullScreen.Enabled = false;
            }
        }

        // EVENT HANDLER stats_ItemPlayed - Se pozove ko se sproži stats.ItemPlayed event
        // Kaj počne: Posodobi labelPlaying z informacijo, koliko pesmi je bilo skupno predvajanih
        // Kadar se sproži: Ko uporabnik predvaja pesem (PlaySelectedItem -> stats.Increment())
        private void stats_ItemPlayed(string itemTitle, int totalPlayed)
        {
            this.BeginInvoke(new Action(() =>
            {
                labelPlaying.Text = $"Predvajanih pesmi: {totalPlayed}";
            }));
        }

        // EVENT HANDLER playlist_PlaylistChanged - Se pozove ko se sproži playlist.PlaylistChanged event
        // Kaj počne: Posodobi labelPlaying z informacijo o spremembi playliste
        // Kadar se sproži: Ko se pesem doda (Add), odstrani (RemoveAt) ali meša (Shuffle)
        // Primeri prikaza: "Dodan: Pesem | Skupno: 5" ali "Playlista je premešana | Skupno: 5"
        private void playlist_PlaylistChanged(string sprememba, int novaKolicina)
        {
            this.BeginInvoke(new Action(() =>
            {
                labelPlaying.Text = $"{sprememba} | Skupno: {novaKolicina}";
            }));
        }

        // EVENT HANDLER playlist_PlaylistError - Se pozove ko se sproži playlist.PlaylistError event
        // Kaj počne: Prikaže obvestilo (MessageBox) o napaki
        // Kadar se sproži: Ko je poskušan dodatek pesmi, ki je že na seznamu (duplikat)
        // Primer: "Napaka: Datoteka 'Pesem1' je že na seznamu"
        private void playlist_PlaylistError(object sender, PlaylistErrorEventArgs e)
        {
            this.BeginInvoke(new Action(() =>
            {
                MessageBox.Show($"Napaka: {e.Sporocilo}", "Napaka pri playlisti");
            }));
        }

        // EVENT HANDLER axMediaPlayer_OpenStateChange - Se pozove ko se sproži Windows Media Player OpenStateChange event
        // Kaj počne: Posodobi labelPlaying, da je datoteka uspešno odprta
        // Kadar se sproži: Ko se datoteka v predvajalniku odpre (e.newState == 13)
        private void axMediaPlayer_OpenStateChange(object sender, _WMPOCXEvents_OpenStateChangeEvent e)
        {
            if (e.newState == 13)
            {
                this.BeginInvoke(new Action(() =>
                {
                    labelPlaying.Text = "Datoteka je odprta";
                }));
            }
        }

        // EVENT HANDLER axMediaPlayer_PlayStateChange - Se pozove ko se sproži Windows Media Player PlayStateChange event
        // Kaj počne: Ko se pesem konča, avtomatski predvaja naslednjo pesem
        // Kadar se sproži: Ko se spremenita stanje predvajanja, posebej ko se pesem konča (e.newState == 8)
        // Primer: Pesem se konča -> event se sproži -> avtomatski gre na buttonNext_Click -> predvaja se naslednja
        private void axMediaPlayer_PlayStateChange(object sender, _WMPOCXEvents_PlayStateChangeEvent e)
        {
            if (e.newState == 8)
            {
                this.BeginInvoke(new Action(() => {

                    if (lstPlaylist.SelectedIndex != -1)
                    {
                        buttonNext_Click(null, null);
                    }
                }));
            }
        }

        private void PlaySelectedItem()
        {
            int index = lstPlaylist.SelectedIndex;
            if (index < 0) return;
            //indexer
            MediaItem item = playlist[index];
            try
            {
                if (item != null)
                {
                    axWindowsMediaPlayer.Ctlcontrols.stop();

                    axWindowsMediaPlayer.URL = item.FilePath;
                    buttonFullScreen.Enabled = (item is VideoItem);
                    axWindowsMediaPlayer.Ctlcontrols.play();

                    stats.Increment();
                    labelPlaying.Text = $"Currently Playing: {item.GetInfo()}";
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("napaka: " + ex.Message);
            }

        }

        private void buttonPlay_Click(object sender, EventArgs e)
        {
            PlaySelectedItem();

        }

        private void buttonPause_Click(object sender, EventArgs e) 
        {
            axWindowsMediaPlayer.Ctlcontrols.pause();


        }

        private void buttonPrevious_Click(object sender, EventArgs e)
        {
            if (lstPlaylist.Items.Count > 0)
            {
                if (lstPlaylist.SelectedIndex > 0)
                {
                    lstPlaylist.SelectedIndex = lstPlaylist.SelectedIndex - 1;
                }
                else
                {           
                    lstPlaylist.SelectedIndex = lstPlaylist.Items.Count - 1;
                }
                axWindowsMediaPlayer.settings.volume = trkVolume.Value;

                PlaySelectedItem();
            }
        }

        private void buttonNext_Click(object sender, EventArgs e)
        {
            if (lstPlaylist.Items.Count > 0)
            {
                if (lstPlaylist.SelectedIndex < lstPlaylist.Items.Count - 1)
                {
                    lstPlaylist.SelectedIndex = lstPlaylist.SelectedIndex + 1;
                }
                else
                {
                    lstPlaylist.SelectedIndex = 0;
                }
                axWindowsMediaPlayer.settings.volume = trkVolume.Value;
                PlaySelectedItem();
            }
        }

        private void buttonAdd_Click(object sender, EventArgs e)
        {
            OpenFileDialog ofd = new OpenFileDialog { Filter = "Media files|*.mp3;*.wav;*.mp4;*.avi" };

            if (ofd.ShowDialog() == DialogResult.OK)
            {
                string ext = System.IO.Path.GetExtension(ofd.FileName).ToLower();
                if (PlayerConfig.IsSupported(ext))
                {
                    MediaItem item;

                    if (ext == ".mp3" || ext == ".wav")
                    {
                        item = new AudioItem(ofd.FileName);
                        
                    }
                    else
                    {
                        item = new VideoItem(ofd.FileName);
                        
                    }

                    bool uspeh = playlist.Add(item);
                    Random r = new Random();
                    item.Duration = TimeSpan.FromMinutes(r.Next(1, 10));

                    if (uspeh == true)
                    {
                        lstPlaylist.Items.Add(item);
                        lstPlaylist.DisplayMember = "Title";
                    }
                    else
                    {
                        MessageBox.Show("Ta datoteka je že na seznamu", "Error", MessageBoxButtons.OKCancel);
                    }
                }
                axWindowsMediaPlayer.settings.volume = trkVolume.Value;

            }

        }


        private void trkVolume_Scroll(object sender, EventArgs e)
        {
            axWindowsMediaPlayer.settings.volume = trkVolume.Value;
        }

        private void lstPlaylist_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (lstPlaylist.SelectedIndex >= 0)
            {
                MediaItem item = playlist.GetAt(lstPlaylist.SelectedIndex);
