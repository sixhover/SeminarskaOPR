using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace MediaPlayer.Core
{
    public class Playlist
    {
        private MediaItem[] items;
        private int count;
        private Random random = new Random();

        /// <summary>
        /// Delegate za filtriranje pesmi po poljubnih kriterijih
        /// </summary>
        /// <param name="item">MediaItem ki se preverja</param>
        /// <returns>true če pesem ustreza kriteriju, false sicer</returns>
        public delegate bool FilterKriterij(MediaItem item);

        /// <summary>
        /// Delegate za obvestilo o spremembah v playlisti
        /// </summary>
        /// <param name="sprememba">Opis kaj se je spremenilo</param>
        /// <param name="novaKolicina">Nova količina pesmi v playlisti</param>
        public delegate void PlaylistChangedEventHandler(string sprememba, int novaKolicina);

        /// <summary>
        /// Event ki se sproži ko se playlista spremeni
        /// </summary>
        public event PlaylistChangedEventHandler PlaylistChanged;

        /// <summary>
        /// Event ki se sproži ko je napaka pri upravljanju playliste
        /// </summary>
        public event EventHandler<PlaylistErrorEventArgs> PlaylistError;

        public int Count { get { return count; } }

        public MediaItem[] Items
        {
            get
            {
                MediaItem[] currentItems = new MediaItem[count];
                for (int i = 0; i < count; i++)
                {
                    currentItems[i] = items[i];
                }
                return currentItems;
            }
        }

        public MediaItem this[int index]
        {
            get
            {
                if (index >= 0)
                {
                    if (index < count)
                    {
                        return items[index];
                    }
                }
                return null;
            }
        }

        public Playlist()
        {
            items = new MediaItem[10];
            count = 0;
        }
        
        /// <summary>
        /// Išče pesmi v playlisti po podanem kriteriju
        /// </summary>
        /// <param name="kriterij">Delegate ki definira pogoj iskanja</param>
        /// <returns>Niz pesmi ki ustrezajo kriteriju</returns>
        public MediaItem[] Isci(FilterKriterij kriterij)
        {
            List<MediaItem> rezultati = new List<MediaItem>();

            for (int i = 0; i < count; i++)
            {
                if (kriterij(items[i]))
                {
                    rezultati.Add(items[i]);
                }
            }
            return rezultati.ToArray();
        }
        
        /// <summary>
        /// Doda novo pesem v playlistu
        /// </summary>
        /// <param name="item">MediaItem ki ga dodajamo</param>
        /// <returns>true če je pesem uspešno dodana, false če je duplikat</returns>
        public bool Add(MediaItem item)
        {
            for (int i = 0; i < count; i++)
            {
                if (items[i].FilePath == item.FilePath)
                {
                    OnPlaylistError($"Datoteka '{item.Title}' je že na seznamu", ErrorType.DuplicateItem);
                    return false;
                }
            }

            if (count == items.Length)
            {
                MediaItem[] newItems = new MediaItem[items.Length * 2];
                for (int i = 0; i < items.Length; i++)
                {
                    newItems[i] = items[i];
                }
                items = newItems;
            }

            items[count] = item;
            count++;
            
            OnPlaylistChanged($"Dodan: {item.Title}", count);
            return true;
        }

        /// <summary>
        /// Odstrani pesem iz playliste na podanem indeksu
        /// </summary>
        /// <param name="index">Indeks pesmi ki jo želimo izbrisati</param>
        public void RemoveAt(int index)
        {
            if (index >= 0 && index < count)
            {
                string removedTitle = items[index].Title;
                for (int i = index; i < count - 1; i++)
                {
                    items[i] = items[i + 1];
                }
                items[count - 1] = null;
                count--;
                
                OnPlaylistChanged($"Odstranjeno: {removedTitle}", count);
            }
        }

        /// <summary>
        /// Vrne pesem na podanem indeksu
        /// </summary>
        /// <param name="index">Indeks pesmi</param>
        /// <returns>MediaItem na podanem indeksu ali null</returns>
        public MediaItem GetAt(int index) => this[index];

        /// <summary>
        /// Izbriše vse pesmi iz playliste
        /// </summary>
        public void Clear()
        {
            for (int i = 0; i < count; i++) items[i] = null;
            count = 0;
        }

        /// <summary>
        /// Naključno meša pesmi v playlisti (Fisher-Yates algoritem)
        /// </summary>
        public void Shuffle()
        {
            for (int i = count - 1; i > 0; i--)
            {
                int j = random.Next(0, i + 1);
                MediaItem temp = items[i];
                items[i] = items[j];
                items[j] = temp;
            }
            
            OnPlaylistChanged("Playlista je premešana", count);
        }

        /// <summary>
        /// Išče pesmi po naslovu
        /// </summary>
        /// <param name="search">Besedilo ki ga iščemo v naslovih</param>
        /// <returns>Niz pesmi ki vsebujejo besedilo v naslovu</returns>
        public MediaItem[] Search(string search)
        {
            int found = 0;
            string s = search.ToLower();
            for (int i = 0; i < count; i++)
            {
                if (items[i].Title.ToLower().Contains(s)) found++;
            }

            MediaItem[] results = new MediaItem[found];
            int resIndex = 0;
            for (int i = 0; i < count; i++)
            {
                if (items[i].Title.ToLower().Contains(s))
                {
                    results[resIndex] = items[i];
                    resIndex++;
                }
            }
            return results;
        }

        /// <summary>
        /// Sortira pesmi v playlisti po trajanju (naraščajoče)
        /// </summary>
        public void SortByDuration()
        {
            if (count < 2) return;
            for (int i = 0; i < count - 1; i++)
            {
                for (int j = 0; j < count - i - 1; j++)
                {
                    if (items[j].Duration > items[j + 1].Duration)
                    {
                        MediaItem temp = items[j];
                        items[j] = items[j + 1];
                        items[j + 1] = temp;
                    }
                }
            }
        }

        /// <summary>
        /// Sproži PlaylistChanged event
        /// </summary>
        /// <param name="sprememba">Opis spremembe</param>
        /// <param name="novaKolicina">Nova količina pesmi</param>
        protected virtual void OnPlaylistChanged(string sprememba, int novaKolicina)
        {
            PlaylistChanged?.Invoke(sprememba, novaKolicina);
        }

        /// <summary>
        /// Sproži PlaylistError event
        /// </summary>
        /// <param name="sporocilo">Opis napake</param>
        /// <param name="tip">Tip napake</param>
        protected virtual void OnPlaylistError(string sporocilo, ErrorType tip)
        {
            PlaylistError?.Invoke(this, new PlaylistErrorEventArgs(sporocilo, tip));
        }

        ~Playlist() { Clear(); }
    }

    /// <summary>
    /// Custom EventArgs za prenašanje podatkov pri PlaylistError eventu
    /// </summary>
    public class PlaylistErrorEventArgs : EventArgs
    {
        public string Sporocilo { get; set; }
        public ErrorType Tip { get; set; }

        /// <summary>
        /// Konstruktor za PlaylistErrorEventArgs
        /// </summary>
        /// <param name="sporocilo">Opisna napaka</param>
        /// <param name="tip">Tip napake</param>
        public PlaylistErrorEventArgs(string sporocilo, ErrorType tip)
        {
            Sporocilo = sporocilo;
            Tip = tip;
        }
    }

    /// <summary>
    /// Enum ki definiše vrste napak pri upravljanju playliste
    /// </summary>
    public enum ErrorType
    {
        /// <summary>Pesem je že v playlisti</summary>
        DuplicateItem,
        /// <summary>Datoteka ni veljavna</summary>
        InvalidFile,
        /// <summary>Druga vrsta napake</summary>
        Other
    }
}