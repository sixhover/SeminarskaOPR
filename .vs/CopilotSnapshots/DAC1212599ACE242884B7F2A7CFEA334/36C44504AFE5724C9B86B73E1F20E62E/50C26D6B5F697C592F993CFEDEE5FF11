        // EVENT HANDLER - Ta metoda se poziva ko se odpre datoteka v predvajalniku
        private void axMediaPlayer_OpenStateChange(object sender, _WMPOCXEvents_OpenStateChangeEvent e)
        {
            // e.newState == 13 pomeni, da je datoteka uspešno odprta
            if (e.newState == 13)
            {
                Console.WriteLine("Datoteka je uspešno odprta");
            }
        }

        
        private void axMediaPlayer_PlayStateChange(object sender, _WMPOCXEvents_PlayStateChangeEvent e)
        {
            // e.newState == 8 pomeni, da se je pesem končala
            if (e.newState == 8)
            {
                this.BeginInvoke(new Action(() => {

                    if (lstPlaylist.SelectedIndex != -1)
                    {
                        buttonNext_Click(null, null);
                    }
                }));
            }
        }

        private void PlaySelectedItem()
        {
            int index = lstPlaylist.SelectedIndex;
            if (index < 0) return;

            //indekser
            MediaItem item = playlist[index];
            try
            {
                if (item != null)
                {
                    axWindowsMediaPlayer.Ctlcontrols.stop();

                    axWindowsMediaPlayer.URL = item.FilePath;
                    buttonFullScreen.Enabled = (item is VideoItem);
                    axWindowsMediaPlayer.Ctlcontrols.play();

                    stats.Increment();
                    labelPlaying.Text = $"Currently Playing: {item.GetInfo()}";
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("napaka: " + ex.Message);
            }

        }

