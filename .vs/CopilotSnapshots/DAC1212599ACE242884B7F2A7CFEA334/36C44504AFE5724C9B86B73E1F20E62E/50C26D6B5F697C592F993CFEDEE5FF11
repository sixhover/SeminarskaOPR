        private int lastVolume = 50;

        // DELEGATE - Prilagojeni delegate za obvestilo korisnika
        // Koristi se za prikaz poroCil
        public delegate void NotificationDelegate(string sporocilo);

        public int CurrentVolume
        {
            get {return axWindowsMediaPlayer.settings.volume;}
            set { axWindowsMediaPlayer.settings.volume = value; }
        }
        public void Mute()
        {
            if (!isMuted)
            {
                lastVolume = CurrentVolume;
                CurrentVolume = 0;

                isMuted = true;
            }
            else
            {
                CurrentVolume = lastVolume;
                isMuted = false;
            }
        }

        public async void FadeOut(int steps, int intervalMs)//z premorim zmanjsuje glasnost in na koncu ustavi predvajanje
        {
            if (steps <= 0) return;
            int decrement = CurrentVolume / steps;
            for (int i = 0; i < steps; i++)
            {
                int newVal = CurrentVolume - decrement;
                CurrentVolume = (newVal < 0) ? 0 : newVal;
                await System.Threading.Tasks.Task.Delay(intervalMs);
            }
            axWindowsMediaPlayer.Ctlcontrols.stop();
        }

        public Form1()
        {
            InitializeComponent();

            playlist = new Playlist();
            stats = new PlayerStats();

            // NAROČANJE NA DOGODKE - Subscribe na dogodke iz objektov
            // To je primer Event Handling - reagiramo na spremembe v objektih

            // Naročimo se na dogodek ItemPlayed iz PlayerStats
            // Ko se sproži, se bo poklicala metoda stats_ItemPlayed
            stats.ItemPlayed += stats_ItemPlayed;

            // Naročimo se na dogodek PlaylistChanged iz Playlist
            playlist.PlaylistChanged += playlist_PlaylistChanged;

            // Naročimo se na dogodek PlaylistError za prikaz napak
            playlist.PlaylistError += playlist_PlaylistError;

            if (trkVolume != null)
            {
                trkVolume.Minimum = 0;
                trkVolume.Maximum = 100;
                trkVolume.Value = 50;

                if (axWindowsMediaPlayer != null && axWindowsMediaPlayer.settings != null)
                {
                    axWindowsMediaPlayer.settings.volume = trkVolume.Value;
                    axWindowsMediaPlayer.uiMode = "none";
                }
            }

            if (axWindowsMediaPlayer != null)
            {
                try
                {
                    // Naročimo se na event PlayStateChange - to je WINDOWS MEDIA PLAYER event
                    // Ko se stanje predvajanja spremeni, se bo poklicala metoda axMediaPlayer_PlayStateChange
                    axWindowsMediaPlayer.PlayStateChange += axMediaPlayer_PlayStateChange;
                    
                    // Naročimo se na event OpenStateChange - ko se datoteka odpre
                    axWindowsMediaPlayer.OpenStateChange += axMediaPlayer_OpenStateChange;
                    
                    axWindowsMediaPlayer.uiMode = "none";
                    if (axWindowsMediaPlayer.settings != null && trkVolume != null)
                    {
                        axWindowsMediaPlayer.settings.volume = trkVolume.Value;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Napaka pri inicializaciji predvajalnika: " + ex.Message);
                }
            }
            

            if (buttonFullScreen != null)
            {
                buttonFullScreen.Enabled = false;
            }
        }

